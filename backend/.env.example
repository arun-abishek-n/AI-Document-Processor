# All variables are optional — defaults live in config.py / app/main.py.
# Copy this file to .env for local development (never commit the real .env).

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default already matches `npm run dev`'s Vite port.
ALLOWED_ORIGINS=http://localhost:5173

# OCR backend: "easyocr" (default, no external binary) or "tesseract"
# (requires the Tesseract binary installed separately and on PATH).
OCR_ENGINE=easyocr

# Only used when OCR_ENGINE=tesseract and the binary isn't already on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Python's root logging level for this service.
LOG_LEVEL=INFO

# Secret used to sign login session tokens (JWT). MUST be overridden with a
# long random value in production — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-secret-change-me

# SQLite by default (see config.py). Point this at a hosted Postgres URL
# instead for persistence across container restarts, e.g.:
#   DATABASE_URL=postgresql://user:password@host/dbname
# DATABASE_URL=sqlite:///./data/app.db
